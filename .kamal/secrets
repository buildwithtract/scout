# Secrets are resolved from the CBP Infisical account (project: scout, env: prod).
# This file contains NO raw credentials and is safe to commit.
#
# Kamal parses this file with dotenv (NOT bash): only `KEY=...` lines are read,
# each `$(...)` is run as a command, and earlier KEYs are visible to later lines.
# So every secret gets its own single-line `KEY=$(infisical secrets get ...)`.
# Do not use `set -a; . file` sourcing here — dotenv ignores it.
#
# CBP Infisical is on EU Cloud, so every call is pinned to --domain.
# (The handover runbook originally assumed US Cloud — the CBP account is EU.)
#
# Required in scout/.env (gitignored): INFISICAL_CLIENT_ID, INFISICAL_CLIENT_SECRET
# (credentials of the "scout-kamal-deploy" machine identity, read-only on scout).
# INFISICAL_PROJECT_ID is the "scout" project ID (not a secret).
INFISICAL_DOMAIN=https://eu.infisical.com
INFISICAL_PROJECT_ID=343e5a93-5075-4c73-8833-52735fa4c084
INFISICAL_TOKEN=$(infisical login --method=universal-auth --client-id=$INFISICAL_CLIENT_ID --client-secret=$INFISICAL_CLIENT_SECRET --domain=$INFISICAL_DOMAIN --plain --silent)

KAMAL_REGISTRY_PASSWORD=$(infisical secrets get KAMAL_REGISTRY_PASSWORD --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
JWT_SECRET_KEY=$(infisical secrets get JWT_SECRET_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=$(infisical secrets get NEXT_PUBLIC_GOOGLE_MAPS_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_ENW_API_KEY=$(infisical secrets get DNOS_ENW_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_UKPN_API_KEY=$(infisical secrets get DNOS_UKPN_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_NGED_API_KEY=$(infisical secrets get DNOS_NGED_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_NPG_API_KEY=$(infisical secrets get DNOS_NPG_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_SPEN_API_KEY=$(infisical secrets get DNOS_SPEN_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DNOS_SSEN_API_KEY=$(infisical secrets get DNOS_SSEN_API_KEY --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
DATABASE_URL=$(infisical secrets get DATABASE_URL --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
POSTGRES_PASSWORD=$(infisical secrets get POSTGRES_PASSWORD --plain --projectId=$INFISICAL_PROJECT_ID --env=prod --domain=$INFISICAL_DOMAIN --token=$INFISICAL_TOKEN --silent)
